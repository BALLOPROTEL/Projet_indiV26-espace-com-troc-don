generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

enum ListingOperationType {
  TRADE
  DONATION
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingAvailabilityStatus {
  AVAILABLE
  RESERVED
  COMPLETED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingReportReason {
  PROHIBITED
  SCAM
  MISLEADING
  HARASSMENT
  DUPLICATE
  OTHER
}

enum ListingReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

model Listing {
  id                 String                    @id @default(cuid())
  ownerId            String
  title              String                    @db.VarChar(120)
  description        String                    @db.VarChar(2000)
  operationType      ListingOperationType
  status             ListingStatus             @default(PENDING)
  availabilityStatus ListingAvailabilityStatus @default(AVAILABLE)
  moderationReason   String?                   @db.VarChar(500)
  category           String?                   @db.VarChar(80)
  city               String?                   @db.VarChar(120)
  condition          ListingCondition?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  images      ListingImage[]
  tradeWishes ListingTradeWish[]
  favorites   ListingFavorite[]
  reports     ListingReport[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([status, availabilityStatus, createdAt])
  @@index([status, category, createdAt])
  @@index([status, city, createdAt])
}

model ListingReport {
  id         String              @id @default(cuid())
  listingId  String
  reporterId String
  reason     ListingReportReason
  details    String?             @db.VarChar(1000)
  status     ListingReportStatus @default(OPEN)
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([listingId, createdAt])
  @@index([reporterId, createdAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  objectKey String   @unique @db.VarChar(500)
  mimeType  String   @db.VarChar(100)
  sizeBytes Int
  position  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
}

model ListingTradeWish {
  id        String   @id @default(cuid())
  listingId String
  label     String   @db.VarChar(120)
  position  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
}


model ListingFavorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
}


enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(140)
  name        String        @db.VarChar(160)
  description String        @db.VarChar(4000)
  category    String        @db.VarChar(120)
  currency    String        @default("EUR") @db.Char(3)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([status, createdAt])
  @@index([status, category, createdAt])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique @db.VarChar(80)
  label      String   @db.VarChar(120)
  priceCents Int
  stock      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
}


model ProductImage {
  id        String   @id @default(cuid())
  productId String
  objectKey String   @unique @db.VarChar(500)
  mimeType  String   @db.VarChar(100)
  sizeBytes Int
  position  Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
}


enum ProductStockReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  COMMITTED
}

model ProductStockReservation {
  id        String                        @id @default(cuid())
  orderId   String                        @unique @db.VarChar(128)
  status    ProductStockReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  items ProductStockReservationItem[]

  @@index([status, expiresAt])
}

model ProductStockReservationItem {
  id            String   @id @default(cuid())
  reservationId String
  productId     String
  variantId     String
  quantity      Int
  createdAt     DateTime @default(now())

  reservation ProductStockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, variantId])
  @@index([reservationId, createdAt])
}
