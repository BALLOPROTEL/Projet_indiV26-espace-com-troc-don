generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("MARKETPLACE_DATABASE_URL")
}

enum ProposalType {
  DONATION_REQUEST
  TRADE_OFFER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MarketplaceTransactionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Proposal {
  id               String         @id @default(cuid())
  targetListingId  String
  requesterId      String
  type             ProposalType
  offeredListingId String?
  message          String?        @db.VarChar(1000)
  status           ProposalStatus @default(PENDING)
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transaction  MarketplaceTransaction?
  conversation Conversation?

  @@index([targetListingId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([offeredListingId, status])
}

model MarketplaceTransaction {
  id                   String                       @id @default(cuid())
  proposalId           String                       @unique
  targetListingId      String
  offeredListingId     String?
  ownerId              String
  requesterId          String
  status               MarketplaceTransactionStatus @default(IN_PROGRESS)
  ownerConfirmedAt     DateTime?
  requesterConfirmedAt DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([targetListingId, status])
  @@index([offeredListingId, status])
}

model Conversation {
  id          String                @id @default(cuid())
  proposalId  String                @unique
  ownerId     String
  requesterId String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  proposal Proposal              @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  messages ConversationMessage[]

  @@index([ownerId, updatedAt])
  @@index([requesterId, updatedAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(1000)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model MarketplaceOutboxEvent {
  eventId      String    @id @db.VarChar(128)
  type         String    @db.VarChar(64)
  payload      Json
  occurredAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?
  attempts     Int       @default(0)

  @@index([publishedAt, createdAt])
}
