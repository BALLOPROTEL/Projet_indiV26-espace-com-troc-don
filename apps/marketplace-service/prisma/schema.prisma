generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("MARKETPLACE_DATABASE_URL")
}

enum ProposalType {
  DONATION_REQUEST
  TRADE_OFFER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MarketplaceTransactionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Proposal {
  id               String         @id @default(cuid())
  targetListingId  String
  requesterId      String
  type             ProposalType
  offeredListingId String?
  message          String?        @db.VarChar(1000)
  status           ProposalStatus @default(PENDING)
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transaction MarketplaceTransaction?

  @@index([targetListingId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([offeredListingId, status])
}

model MarketplaceTransaction {
  id                   String                       @id @default(cuid())
  proposalId           String                       @unique
  targetListingId      String
  offeredListingId     String?
  ownerId              String
  requesterId          String
  status               MarketplaceTransactionStatus @default(IN_PROGRESS)
  ownerConfirmedAt     DateTime?
  requesterConfirmedAt DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([targetListingId, status])
  @@index([offeredListingId, status])
}
