{
  "name": "marketplace-service",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "start:dev": "pnpm prisma:generate && ts-node --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "pnpm prisma:generate && jest --runInBand",
    "test:coverage": "pnpm prisma:generate && jest --runInBand --coverage",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "amqplib": "2.2.0",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
