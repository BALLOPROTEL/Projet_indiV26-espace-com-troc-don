{
  "name": "projet-individuel26",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "api:dev": "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "api:typecheck": "pnpm --filter api typecheck",
    "api:test": "pnpm --filter api test",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate:dev",
    "db:deploy": "pnpm --filter api prisma:migrate:deploy",
    "api:lint": "pnpm --filter api lint",
    "api:test:coverage": "pnpm --filter api test:coverage",
    "api:test:integration": "pnpm --filter api test:integration",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "api:quality": "pnpm api:lint && pnpm api:typecheck && pnpm api:test && pnpm api:test:integration && pnpm api:test:e2e && pnpm api:test:coverage && pnpm api:build",
    "api:audit:prod": "pnpm audit --prod --audit-level=high",
    "api:image:build": "docker build --pull -f apps/api/Dockerfile -t projet-indiv26-api:lot5-local .",
    "api:image:smoke": "bash scripts/lot5-image-smoke.sh projet-indiv26-api:lot5-local",
    "k8s:render": "kubectl kustomize infra/k8s/minikube",
    "k8s:validate:manifests": "bash scripts/lot6-k8s-validate.sh --manifest-only",
    "k8s:up": "bash scripts/lot6-minikube-up.sh",
    "k8s:validate": "bash scripts/lot6-k8s-validate.sh",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:typecheck": "pnpm --filter web typecheck",
    "web:test": "pnpm --filter web test",
    "web:quality": "pnpm --filter web quality",
    "obs:validate:manifests": "bash scripts/lot7-observability-validate.sh --manifest-only",
    "obs:validate": "bash scripts/lot7-observability-validate.sh",
    "obs:up": "bash scripts/lot7-minikube-up.sh",
    "load:validate": "bash scripts/lot8-load-validate.sh",
    "load:run": "bash scripts/lot8-load-run.sh",
    "security:audit:static": "bash scripts/lot9-security-audit.sh --static",
    "security:audit": "bash scripts/lot9-security-audit.sh",
    "security:live": "bash scripts/lot9-security-live.sh",
    "marketplace:validate": "pnpm db:generate && pnpm --filter api exec prisma validate && pnpm --filter api exec jest --runInBand src/marketplace/marketplace-rules.service.spec.ts",
    "storage:up": "docker compose up -d minio minio-init",
    "storage:validate:manifests": "bash scripts/lot9b-storage-validate.sh --static",
    "storage:validate": "bash scripts/lot9b-storage-validate.sh",
    "publication:validate": "pnpm db:generate && pnpm --filter api exec jest --runInBand src/marketplace/marketplace-rules.service.spec.ts src/listings/listings.service.spec.ts && pnpm web:test",
    "codespaces:up": "bash scripts/codespaces-up.sh",
    "codespaces:down": "bash scripts/codespaces-down.sh",
    "codespaces:check": "bash scripts/codespaces-check.sh",
    "codespaces:dev": "bash scripts/codespaces-dev.sh"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.1"
    }
  }
}
