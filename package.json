{
  "name": "projet-individuel26",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "api:dev": "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "api:typecheck": "pnpm --filter api typecheck",
    "api:test": "pnpm --filter api test",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate:dev",
    "db:deploy": "pnpm --filter api prisma:migrate:deploy",
    "api:lint": "pnpm --filter api lint",
    "api:test:coverage": "pnpm --filter api test:coverage",
    "api:test:integration": "pnpm --filter api test:integration",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "api:quality": "pnpm api:lint && pnpm api:typecheck && pnpm api:test && pnpm api:test:integration && pnpm api:test:e2e && pnpm api:test:coverage && pnpm api:build"
  }
}
