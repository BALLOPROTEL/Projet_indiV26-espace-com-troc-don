FROM alpine:3.24.1

ARG TARGETARCH
ARG MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
ARG MINIO_SHA256_AMD64=53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c
ARG MINIO_SHA256_ARM64=6c2f3142c94240206123177f4ba1e360daa5d1e0a4962e90757ef4f92c3ab57c

RUN set -eux; \
  apk add --no-cache ca-certificates curl; \
  arch="${TARGETARCH:-amd64}"; \
  case "${arch}" in \
    amd64) sha="${MINIO_SHA256_AMD64}" ;; \
    arm64) sha="${MINIO_SHA256_ARM64}" ;; \
    *) echo "Unsupported architecture: ${arch}" >&2; exit 1 ;; \
  esac; \
  curl -fsSL \
    "https://github.com/minio/minio/releases/download/${MINIO_VERSION}/minio.linux-${arch}.${MINIO_VERSION}" \
    -o /usr/local/bin/minio; \
  echo "${sha}  /usr/local/bin/minio" | sha256sum -c -; \
  chmod 0755 /usr/local/bin/minio; \
  addgroup -S -g 1000 minio; \
  adduser -S -D -H -u 1000 -G minio minio; \
  mkdir -p /data; \
  chown -R minio:minio /data

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/minio"]
